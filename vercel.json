{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://isaplanner-489f0.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://isaplanner-489f0.firebaseapp.com/__/firebase/:path*" },
    { "source": "/((?!__/).*)", "destination": "/index.html" }
  ]
}
