  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "firebase-tools": "^15.33.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
